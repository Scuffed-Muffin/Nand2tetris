// File name: projects/1/Or.hdl
/**
 * Or gate:
 * if (a or b) out = 1, else out = 0 
 */
CHIP Or {
    IN a, b;
    OUT out;

    PARTS:
    Not(in= a, out= c);
    Not(in= b, out= d);
    And(a= c, b= d, out= e);
    Nand(a= a, b= b, out= f);
    Nand(a= e, b= f, out= out);
}
