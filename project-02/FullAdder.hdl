
CHIP FullAdder {
    IN a, b, c;  // 1-bit inputs
    OUT sum,     // Right bit of a + b + c
        carry;   // Left bit of a + b + c

    PARTS:
    Xor(a= a, b= b, out= d);
    Xor(a= d, b= c, out= sum);
    And(a= a, b= b, out= ab);
    And(a= a, b= c, out= ac);
    And(a= b, b= c, out= bc);
    Xor(a= ab, b= ac, out= e);
    Xor(a= e, b= bc, out= carry);
}
